PROJECT_NAME="Om Sai Textile ERP API"
API_V1_STR="/api/v1"

# Local SQLite (Runs immediately out-of-the-box with zero setup):
DATABASE_URL="sqlite:///./om_sai.db"

# For Cloud PostgreSQL (Supabase / Neon), uncomment and paste your connection string:
# DATABASE_URL="postgresql://postgres:your_password@your_host:5432/postgres"

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# SMTP Email Configuration (Optional - for real email OTP delivery via Gmail/SendGrid/Brevo/SES):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="yourcompany@gmail.com"
# SMTP_PASSWORD="your-google-app-password"
# SMTP_FROM_NAME="TexaFlow Textile ERP"
# SMTP_FROM_EMAIL="yourcompany@gmail.com"
